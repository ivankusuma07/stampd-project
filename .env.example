# STAMPD environment (development plan §6). Copy to .env; never commit real keys.
# One key per role (development plan 7.2). The deployer key is for deploys only — never on a server.

# ---- chain
CHAIN_ID=46630                      # 46630 testnet · 4663 mainnet · 31337 local anvil
RPC_URL=                            # e.g. https://robinhood-testnet.g.alchemy.com/v2/<key>
RPC_URL_BACKUP=                     # second provider (plan R19)
DEPLOYER_PRIVATE_KEY=               # packages/contracts deploy only
ADMIN_ADDRESS=                      # contract admin + pauser; defaults to the deployer (multisig before mainnet)
ARBITER_ADDRESS=                    # dispute arbiter; defaults to the deployer (multisig before mainnet)
CREATOR_ADDRESS=                    # public addresses of the keys below, used by the deploy script
RESOLVER_ADDRESS=
FAUCET_SIGNER_ADDRESS=
CREATOR_PRIVATE_KEY=                # worker: MarketFactory.createMarket
RESOLVER_PRIVATE_KEY=               # worker: Resolver.propose / finalize
FAUCET_SIGNER_PRIVATE_KEY=          # api: signs faucet vouchers
INDEXER_CONFIRMATIONS=2

# ---- data
DATABASE_URL=                       # Railway Postgres: ${{Postgres.DATABASE_URL}} (app and migrations)
DIRECT_URL=                         # optional: a separate unpooled URL for prisma migrate (only behind a pooler)
DATABASE_POOL_MAX=                  # optional pool size
REDIS_URL=                          # Railway Redis: ${{Redis.REDIS_URL}} (BullMQ, SIWE nonces, status flags)

# ---- services
SCRAPER_URL=http://localhost:8000
SCRAPER_TOKEN=                      # shared bearer token between worker and apps/scraper
SCRAPER_ENABLED=true                # kill switch (plan B6b): false stops all scraping
SCRAPER_MIN_ACTIVE_ACCOUNTS=2
CANARY_HANDLE=coinbase
DEEPSEEK_API_KEY=                   # the only AI provider (docs/decisions.md D13)
AI_MODEL=deepseek-flash             # or deepseek-v4-pro
AI_THINKING=disabled                # enabled = DeepSeek thinking mode: same results in the live check, ~2.3x cost
IPFS_PIN_TOKEN=                     # Pinata JWT; without it specs/evidence are embedded as data: URIs
TURNSTILE_SECRET=                   # required in production
RESEND_API_KEY=                     # optional: email alerts
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=STAMPD alerts <alerts@your-domain>

# ---- api
PORT=4000
HOST=::                             # "::" = IPv6 + IPv4 (Railway's private network is IPv6)
SIWE_DOMAIN=localhost:3000          # must equal the web app's host
SESSION_SECRET=                     # ≥ 32 random characters
ADMIN_ADDRESSES=                    # comma-separated wallet allowlist
WEB_ORIGIN=http://localhost:3000
FAUCET_CLAIM_USD=100

# ---- web (apps/web)
API_URL=http://localhost:4000       # server-side; the browser uses /api (rewrite)
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # optional; without it only injected wallets are offered
NEXT_PUBLIC_X_URL=                  # https://x.com/StampDCreator in production; the X icons stay hidden until set
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- scraper (apps/scraper)
ACCOUNTS_DB=data/accounts.db        # twscrape sessions; dedicated accounts only (plan B6b)
