{
  "name": "@stampd/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "indexer:backfill": "tsx --env-file-if-exists=../../.env src/cli.ts backfill",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "indexer:reconcile": "tsx --env-file-if-exists=../../.env src/cli.ts reconcile",
    "local": "tsx scripts/local-stack.ts",
    "redraft": "tsx --env-file-if-exists=../../.env src/cli.ts redraft",
    "reroute": "tsx --env-file-if-exists=../../.env src/cli.ts reroute"
  },
  "dependencies": {
    "@stampd/ai": "workspace:*",
    "@stampd/chain": "workspace:*",
    "@stampd/core": "workspace:*",
    "@stampd/db": "workspace:*",
    "@stampd/queue": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "viem": "^2.57.1",
    "zod": "^4.6.5",
    "@stampd/api": "workspace:*",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "^24.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
